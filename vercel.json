{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/site.py": {
      "includeFiles": "src/**"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/site?p=index" },
    { "source": "/cars/:code", "destination": "/api/site?p=car&code=:code" },
    { "source": "/sitemap.xml", "destination": "/api/site?p=sitemap" },
    { "source": "/llms.txt", "destination": "/api/site?p=llms" }
  ],
  "headers": [
    {
      "source": "/photos/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
